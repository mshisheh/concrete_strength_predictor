# Environment variables template for Concrete Strength Predictor
# Copy this file to .env and fill in your specific values

# =============================================================================
# MLflow Configuration
# =============================================================================
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=concrete_strength
# For remote MLflow server:
# MLFLOW_TRACKING_URI=http://localhost:5000
# For cloud storage:
# MLFLOW_ARTIFACT_LOCATION=s3://my-bucket/artifacts
# MLFLOW_REGISTRY_URI=sqlite:///mlflow_registry.db

# =============================================================================
# Database Configuration (Optional - if using database storage)
# =============================================================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=concrete_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DATABASE_URL=postgresql://user:password@localhost:5432/concrete_db

# =============================================================================
# Kaggle API Configuration (Optional - for Kaggle data downloads)
# =============================================================================
# Get these from https://www.kaggle.com/account (Create New API Token)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# =============================================================================
# Deployment Configuration
# =============================================================================
ENVIRONMENT=development
DEBUG=True
PORT=8501
HOST=0.0.0.0
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# Model Configuration
# =============================================================================
RANDOM_STATE=42
TEST_SIZE=0.2
VAL_SIZE=0.2
CV_FOLDS=5
N_JOBS=-1

# =============================================================================
# Data Configuration
# =============================================================================
DATA_DIR=data
MODELS_DIR=models
PLOTS_DIR=plots
MLRUNS_DIR=mlruns

# =============================================================================
# Security Configuration (for production deployment)
# =============================================================================
# SECRET_KEY=your_secret_key_here
# ALLOWED_HOSTS=yourdomain.com,localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# =============================================================================
# Cloud Storage Configuration (Optional)
# =============================================================================
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name

# =============================================================================
# Monitoring Configuration (Optional)
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn
# PROMETHEUS_PORT=9090
# HEALTH_CHECK_URL=/health
